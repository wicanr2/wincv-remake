# 原版解出的素材:可由 wincv052a.exe 用 tools/setup-wine-oracle.sh 重建,不進版控
/original/app/

# Wine prefix 一律放 $HOME,不該出現在 repo 內
/wineprefix/
/.wine*/

# Go
/bin/
/dist/
*.exe
!wincv052a.exe

# 暫存
*.xwd
*.tmp
/original/eten/
/.cache/
__pycache__/
*.pyc

# docker build 掉在 repo 根目錄的執行檔
/wincv
/celldump

# IDA 的工作目錄(資料庫十幾 MB,可由 tools/ida.sh 重建)
/.ida/

# Android 建置產物
/android/app/libs/*.aar
/android/app/build/
/android/.gradle/
/dist-all/

# ebitenmobile bind 的產物。.aar 一直是未追蹤的,-sources.jar 卻曾經被
# 加進版控 —— 於是每建一次 Android,工作區就變髒,而 dist-all 的建置
# 印記會標成 -dirty,看起來像「這個執行檔含未提交的程式碼」。
# 兩個都是 tools/build-android.sh 產生的,一起排除。
/android/app/libs/

# 模擬器實跑的原始產物(每跑一次就重生)。留下來的是 android-emulator.png
docs/ui/android-run-*.png
docs/ui/android-logcat.txt
docs/ui/android-crash.txt
docs/ui/android-emulator.log

# 內嵌字型的素材:第三方版權物,由 tools/build-full.sh 臨時放進來
/internal/bundled/assets/
