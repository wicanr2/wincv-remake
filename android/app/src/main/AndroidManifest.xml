<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 第一版是唯讀瀏覽器,只要求讀取權限。
         Android 11 起要瀏覽任意目錄需要「所有檔案存取權」,
         那是使用者要在系統設定裡手動開的;沒開的話只看得到
         app 自己的目錄與 Download。這是 scoped storage 的設計,
         不是程式的限制。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="WinCV"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true">
        <!-- configChanges 要列得夠寬:Ebiten 的 Android view 用一個 static
             旗標記「這個行程建過幾次 GL surface」,第二次就判定 context 遺失
             並呼叫 Runtime.exit(0)。也就是說 **Activity 被重建一次就等於
             app 結束**,而轉向、螢幕密度、深色模式、語言都會觸發重建。
             把它們全部自己吃下來,Activity 就不會被重建。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation|touchscreen|layoutDirection|fontScale|locale|mcc|mnc"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
